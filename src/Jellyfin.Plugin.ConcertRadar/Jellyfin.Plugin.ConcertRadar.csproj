<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>Jellyfin.Plugin.ConcertRadar</RootNamespace>
    <Product>Jellyfin Concert Radar</Product>
    <Authors>Alpha</Authors>
    <Version>0.2.0.0</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embed SQL migration scripts as assembly resources so SchemaMigrator can read them at runtime. -->
    <EmbeddedResource Include="Storage/Migrations/*.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed web UI pages (admin config page, user concerts view) as assembly resources. -->
    <EmbeddedResource Include="Web/*.html;Web/*.js;Web/*.css" />
  </ItemGroup>

  <ItemGroup>
    <!-- Jellyfin 12.0.0 targets net10.0. Keep package versions in lockstep with the server ABI. -->
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="12.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- Direct from Jellyfin 12: BaseItemKind was transitive through Jellyfin.Controller before. -->
    <PackageReference Include="Jellyfin.Data" Version="12.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- SQLite persistence. Exact pin; native libe_sqlite3 ships via build.yaml artifacts. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />

    <!--
      AngleSharp is the canonical HTML parsing library for all scrapers in this plugin.
      Do NOT add a second HTML parser (e.g. HtmlAgilityPack) - use AngleSharp for everything.
    -->
    <PackageReference Include="AngleSharp" Version="1.8.3" />
  </ItemGroup>

</Project>
