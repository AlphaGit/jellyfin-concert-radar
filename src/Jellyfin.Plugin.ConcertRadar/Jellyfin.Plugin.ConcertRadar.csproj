<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>Jellyfin.Plugin.ConcertRadar</RootNamespace>
    <Product>Jellyfin Concert Radar</Product>
    <Authors>Alpha</Authors>
    <Version>0.1.0.0</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embed SQL migration scripts as assembly resources so SchemaMigrator can read them at runtime. -->
    <EmbeddedResource Include="Storage/Migrations/*.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed web UI pages (admin config page, user concerts view) as assembly resources. -->
    <EmbeddedResource Include="Web/*.html;Web/*.js;Web/*.css" />
  </ItemGroup>

  <ItemGroup>
    <!-- Jellyfin 10.11.6 targets net9.0. Keep package versions in lockstep with the server ABI. -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.6">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.6">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- SQLite persistence (net9-compatible baseline) -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.*" />

    <!--
      AngleSharp is the canonical HTML parsing library for all scrapers in this plugin.
      Do NOT add a second HTML parser (e.g. HtmlAgilityPack) - use AngleSharp for everything.
    -->
    <PackageReference Include="AngleSharp" Version="1.*" />
  </ItemGroup>

</Project>
