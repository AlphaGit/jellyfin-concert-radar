<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>Jellyfin.Plugin.ConcertRadar</RootNamespace>
    <Product>Jellyfin Concert Radar</Product>
    <Authors>Alpha</Authors>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Jellyfin references: exclude runtime assets so the host's copies are used -->
    <!-- Jellyfin 10.10.x is the last release targeting net8.0.
         Jellyfin 10.11.x moved to net9.0; pin to 10.10.7 until the build
         environment upgrades to a net9 SDK. See SPEC §3 deviation note. -->
    <PackageReference Include="Jellyfin.Controller" Version="10.10.7">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.10.7">
      <ExcludeAssets>runtime</ExcludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- SQLite persistence -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.*" />

    <!--
      AngleSharp is the canonical HTML parsing library for all scrapers in this plugin.
      Do NOT add a second HTML parser (e.g. HtmlAgilityPack) — use AngleSharp for everything.
    -->
    <PackageReference Include="AngleSharp" Version="1.*" />
  </ItemGroup>

</Project>
